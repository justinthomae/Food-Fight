{
  "name": "food-fight-app",
  "private": true,
  "version": "1.24.0",
  "description": "Food Fight for iPhone and Android: the website in a Capacitor shell. See docs/STORE_RELEASE.md.",
  "scripts": {
    "build:www": "node scripts/build-www.mjs",
    "cap:add": "npx cap add ios && npx cap add android",
    "cap:sync": "npm run build:www && npx cap sync",
    "cap:assets": "capacitor-assets generate --assetPath resources --iconBackgroundColor '#131627' --iconBackgroundColorDark '#131627' --splashBackgroundColor '#131627' --splashBackgroundColorDark '#131627'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
